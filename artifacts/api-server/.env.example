API_KEY=replace-with-a-long-random-key
# Use this for an external Neon database in Replit. It takes precedence over the reserved DATABASE_URL.
BLOXEN_DATABASE_URL=postgresql://user:password@host.neon.tech/bloxen?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/bloxen
PRESENCE_INTERVAL=60
CACHE_TTL=30
CORS_ORIGINS=*
ENVIRONMENT=production
ROBLOX_TIMEOUT=8
ROBLOX_RETRIES=2
VERIFICATION_TTL=600
VERIFICATION_MAX_ATTEMPTS=5
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60